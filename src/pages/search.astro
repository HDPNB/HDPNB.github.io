---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="搜索" description="搜索HDP的个人空间里留下的文章。">
  <header class="page-hero container">
    <span class="eyebrow">SEARCH STORIES</span>
    <h1>找一段留下来的Story</h1>
    <p>试试输入校园、黄昏、ESP32，或者任何你突然想到的词。</p>
  </header>
  <section class="page-section--tight">
    <div class="container">
      <div class="search-box">
        <label style="flex:1">
          <span class="skip-link">搜索关键词</span>
          <input class="search-input" type="search" placeholder="输入关键词…" autocomplete="off" data-search-input />
        </label>
        <button class="button button--primary" type="button" data-search-button>搜索</button>
      </div>
      <p class="search-count" aria-live="polite">共收录 {posts.length} 篇Story</p>
      <div class="post-grid search-results">{posts.map((post) => <PostCard post={post} />)}</div>
      <p class="filter-empty search-empty" hidden>好像还没有留下关于这个关键词的Story。</p>
    </div>
  </section>
  <script>
    const input = document.querySelector<HTMLInputElement>('[data-search-input]');
    const button = document.querySelector<HTMLButtonElement>('[data-search-button]');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.search-results .post-card'));
    const count = document.querySelector<HTMLElement>('.search-count');
    const empty = document.querySelector<HTMLElement>('.search-empty');
    const originals = new Map<Element, string>();
    cards.forEach((card) => card.querySelectorAll('h3 a, .post-card__body > p').forEach((el) => originals.set(el, el.textContent || '')));

    const escapeRegExp = (text: string) => text.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const highlight = (el: Element, keyword: string) => {
      const original = originals.get(el) || '';
      el.textContent = '';
      if (!keyword) { el.textContent = original; return; }
      const regex = new RegExp(`(${escapeRegExp(keyword)})`, 'ig');
      original.split(regex).forEach((part) => {
        if (part.toLowerCase() === keyword.toLowerCase()) {
          const mark = document.createElement('mark'); mark.textContent = part; el.appendChild(mark);
        } else el.appendChild(document.createTextNode(part));
      });
    };
    const search = () => {
      const keyword = (input?.value || '').trim().toLowerCase();
      let total = 0;
      cards.forEach((card) => {
        const matched = !keyword || (card.dataset.search || '').includes(keyword);
        card.hidden = !matched;
        if (matched) total += 1;
        card.querySelectorAll('h3 a, .post-card__body > p').forEach((el) => highlight(el, keyword));
      });
      if (count) count.textContent = keyword ? `找到 ${total} 篇相关Story` : `共收录 ${cards.length} 篇Story`;
      if (empty) empty.hidden = total > 0;
      const url = new URL(location.href);
      keyword ? url.searchParams.set('q', keyword) : url.searchParams.delete('q');
      history.replaceState({}, '', url);
    };
    input?.addEventListener('input', search);
    button?.addEventListener('click', search);
    const initial = new URLSearchParams(location.search).get('q');
    if (initial && input) { input.value = initial; search(); }
  </script>
</BaseLayout>
