---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import PostCard from '@/components/PostCard.astro';
import PhotoGrid from '@/components/PhotoGrid.astro';
import RandomStory from '@/components/RandomStory.astro';
import MemoryScene3D from '@/components/MemoryScene3D.astro';
import DailyFortune from '@/components/DailyFortune.astro';
import GuestbookEncounter from '@/components/GuestbookEncounter.astro';
import { siteConfig } from '@/data/site';
import { featuredPhotos } from '@/data/photos';
import { dailyMoods, welcomeMessages } from '@/data/interactions';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);
const homeTitleLines = siteConfig.homeTitle.split('\n');
---

<BaseLayout title={siteConfig.name} description={siteConfig.description}>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <span class="eyebrow">WELCOME, FRIEND</span>
        <h1 aria-label={siteConfig.homeTitle.replace('\n', '，')}>
          {homeTitleLines.map((line) => <span>{line}</span>)}
        </h1>
        <p class="hero__subtitle">{siteConfig.homeSubtitle}</p>
        <div class="hero__note">
          {siteConfig.homeNote.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <div class="hero__actions" data-home-interactions data-welcomes={JSON.stringify(welcomeMessages)}>
          <button class="button button--primary" type="button" data-random-welcome>随便看看</button>
          <a class="button button--ghost" href="/search/">最近更新</a>
        </div>
        <p class="hero__welcome" data-welcome-output aria-live="polite">点一下“随便看看”，这里会送你一句随机欢迎。</p>
        <div class="hero__guide">
          {siteConfig.homeGuide.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
      <div class="hero__visual">
        <MemoryScene3D />
        <button
          class="hero__note-card"
          type="button"
          data-random-mood
          data-moods={JSON.stringify(dailyMoods)}
          aria-label="换一句今日心情"
        >今日份：<span data-mood-text>慢一点，也没关系。</span></button>
      </div>
    </div>
  </section>

  <section class="page-section--tight">
    <div class="container intro-card reveal">
      <div>
        <span class="eyebrow">ABOUT THIS PLACE</span>
        <h2>{siteConfig.introTitle}</h2>
        {siteConfig.introText.map((paragraph) => <p>{paragraph}</p>)}
        <div class="chip-list">{siteConfig.introTags.map((tag) => <span>{tag}</span>)}</div>
      </div>
      <div class="intro-doodle" aria-hidden="true">慢</div>
    </div>
  </section>

  <section class="page-section--tight">
    <div class="container">
      <DailyFortune />
      <a class="interaction-corner-link" href="/interactions/">
        <span aria-hidden="true">✦</span>
        <div>
          <strong>去互动角落走走</strong>
          <small>星空墙、漂流瓶、时光胶囊和答案之书都放在那里</small>
        </div>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="page-section" id="recent">
    <div class="container">
      <SectionHeading eyebrow="RECENT STORIES" title="最近留下的片段" text={siteConfig.recentText} />
      <div class="post-grid">{posts.map((post) => <PostCard post={post} />)}</div>
      <div class="section-end section-end--actions">
        <a class="button button--soft" href="/search/">看看全部Story</a>
        <RandomStory />
      </div>
    </div>
  </section>

  <section class="page-section--tight">
    <div class="container">
      <GuestbookEncounter />
    </div>
  </section>

  <section class="page-section soft-section">
    <div class="container">
      <SectionHeading eyebrow="PHOTO NOTES" title="精选照片" text={siteConfig.featuredPhotosText} />
      <PhotoGrid photos={featuredPhotos} />
    </div>
  </section>
  <script>
    import {
      browserSeed,
      dailyRandom,
      entryRandom,
      pickRandom,
    } from '@/lib/random';

    const welcomeRandom = entryRandom('home-welcome');
    const welcomeRoot = document.querySelector<HTMLElement>('[data-home-interactions]');
    const welcomeButton = welcomeRoot?.querySelector<HTMLButtonElement>('[data-random-welcome]');
    const welcomeOutput = document.querySelector<HTMLElement>('[data-welcome-output]');
    welcomeButton?.addEventListener('click', () => {
      const messages = JSON.parse(welcomeRoot?.dataset.welcomes || '[]') as string[];
      const message = pickRandom(messages, welcomeRandom).value;
      if (welcomeOutput && message) welcomeOutput.textContent = message;
    });

    const moodButton = document.querySelector<HTMLButtonElement>('[data-random-mood]');
    const moodText = moodButton?.querySelector<HTMLElement>('[data-mood-text]');
    const moods = JSON.parse(moodButton?.dataset.moods || '[]') as string[];
    const moodRandom = entryRandom('home-mood-change');
    let moodIndex = -1;
    const updateMood = (daily = false) => {
      if (!moodText || moods.length === 0) return;
      const picked = pickRandom(
        moods,
        daily ? dailyRandom(`${browserSeed()}:home-mood`) : moodRandom,
        moodIndex,
      );
      moodIndex = picked.index;
      moodText.textContent = picked.value || moods[0];
    };
    updateMood(true);
    moodButton?.addEventListener('click', () => updateMood(false));
  </script>
</BaseLayout>
