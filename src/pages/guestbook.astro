---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CloudBaseGuestbook from '@/components/CloudBaseGuestbook.astro';
---

<BaseLayout title="留言板" description="欢迎留下一句话、一段故事，或者只是来打个招呼。">
  <header class="page-hero container">
    <span class="eyebrow">GUESTBOOK</span>
    <h1>欢迎留下你想留下的话。</h1>
    <p>可以是一句话、一段故事，也可以只是来打个招呼。</p>
  </header>
  <section class="page-section--tight">
    <div class="narrow">
      <CloudBaseGuestbook />
    </div>
  </section>
</BaseLayout>
