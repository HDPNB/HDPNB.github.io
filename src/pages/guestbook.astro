---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CloudBaseGuestbook from '@/components/CloudBaseGuestbook.astro';
import { guestbookConfig } from '@/data/site';
---

<BaseLayout title="留言板" description={guestbookConfig.description}>
  <header class="page-hero container">
    <span class="eyebrow">GUESTBOOK</span>
    <h1>{guestbookConfig.title}</h1>
    <p>{guestbookConfig.description}</p>
  </header>
  <section class="page-section--tight">
    <div class="narrow">
      <CloudBaseGuestbook />
    </div>
  </section>
</BaseLayout>
