---
import { musicTracks } from '@/data/music';

const hasTracks = musicTracks.length > 0;
const firstTrack = musicTracks[0];
const musicTags = [...new Set(musicTracks.flatMap((track) => track.tags))];
---

<section
  class:list={['music-player', { 'music-player--empty': !hasTracks }]}
  data-music-player
  data-tracks={JSON.stringify(musicTracks)}
  aria-label="全局音乐播放器"
>
  <audio preload="metadata" data-music-audio></audio>

  <div class="music-player__main">
    <div class="music-player__cover" aria-hidden="true">
      <img
        src={firstTrack?.cover || '/images/life/my_day.webp'}
        alt=""
        width="96"
        height="96"
        data-music-cover
      />
      <span>♪</span>
    </div>

    <div class="music-player__content">
      <div class="music-player__heading">
        <div class="music-player__text">
          <strong data-music-title>{firstTrack?.title || '还没有放进音乐'}</strong>
          <span data-music-artist>{firstTrack?.artist || '把有权公开播放的音频放到 public/audio/'}</span>
        </div>
        <button
          class="music-icon-button music-list-toggle"
          type="button"
          aria-label="展开播放列表"
          aria-expanded="false"
          data-music-list-toggle
        >列表</button>
      </div>

      <div class="music-player__controls">
        <button class="music-icon-button" type="button" aria-label="上一首" data-music-prev disabled={!hasTracks}>‹</button>
        <button class="music-play-button" type="button" aria-label="播放" data-music-play disabled={!hasTracks}>
          <span data-play-icon aria-hidden="true">▶</span>
        </button>
        <button class="music-icon-button" type="button" aria-label="下一首" data-music-next disabled={!hasTracks}>›</button>
        <div class="music-player__timeline">
          <input
            type="range"
            min="0"
            max="100"
            step="0.1"
            value="0"
            aria-label="播放进度"
            data-music-progress
            disabled={!hasTracks}
          />
          <div><span data-music-current>0:00</span><span data-music-duration>0:00</span></div>
        </div>
        <button class="music-icon-button" type="button" aria-label="静音" data-music-mute disabled={!hasTracks}>音</button>
        <input
          class="music-player__volume"
          type="range"
          min="0"
          max="1"
          step="0.05"
          value="0.7"
          aria-label="音量"
          data-music-volume
          disabled={!hasTracks}
        />
      </div>
      <p class="music-player__status" data-music-status aria-live="polite">
        {hasTracks ? '点击播放，声音才会开始。' : '播放器已经准备好，添加音频后即可使用。'}
      </p>
    </div>
  </div>

  <div class="music-playlist" data-music-playlist hidden>
    <div class="music-playlist__header">
      <strong>播放列表</strong>
      <span data-music-result-count>{musicTracks.length} 首</span>
    </div>

    <label class="music-search">
      <span class="skip-link">搜索本地歌曲</span>
      <input
        type="search"
        placeholder="搜歌曲或歌手…"
        autocomplete="off"
        data-music-search
        disabled={!hasTracks}
      />
    </label>

    <div class="music-scope" aria-label="播放列表范围">
      <button type="button" class="is-active" data-music-scope="all" aria-pressed="true" disabled={!hasTracks}>全部歌曲</button>
      <button type="button" data-music-scope="recent" aria-pressed="false" disabled={!hasTracks}>最近播放</button>
      <button type="button" data-music-scope="favorites" aria-pressed="false" disabled={!hasTracks}>我的收藏</button>
    </div>

    {musicTags.length > 0 && (
      <div class="music-tags" aria-label="按标签筛选歌曲">
        <button type="button" class="is-active" data-music-tag="" aria-pressed="true">全部标签</button>
        {musicTags.map((tag) => (
          <button type="button" data-music-tag={tag} aria-pressed="false">{tag}</button>
        ))}
      </div>
    )}

    <div class="music-playlist__tools">
      <button type="button" data-music-mode aria-label="当前播放模式：列表循环，点击切换">模式：列表循环</button>
      <button type="button" data-music-surprise aria-label="从当前筛选结果随机选择并播放歌曲" disabled={!hasTracks}>随便听听</button>
    </div>

    <ol data-music-list></ol>
    <p class="music-search-empty" data-music-empty hidden>暂时没有找到这首歌。</p>
    {!hasTracks && (
      <p class="music-playlist__empty">在 <code>src/data/music.ts</code> 中添加歌曲配置后，这里会显示播放列表。</p>
    )}

    <a
      class="music-qq-link"
      href={firstTrack?.qqMusicUrl || '#'}
      target="_blank"
      rel="noreferrer"
      data-music-qq
      hidden={!firstTrack?.qqMusicUrl}
    >前往QQ音乐收听</a>
  </div>
</section>

<script>
  type Track = {
    title: string;
    artist: string;
    cover: string;
    src: string;
    tags: string[];
    qqMusicUrl?: string;
  };
  type PlayMode = 'list' | 'single' | 'shuffle' | 'sequential';
  type ListScope = 'all' | 'recent' | 'favorites';
  type SavedState = {
    index?: number;
    src?: string;
    progress?: number;
    volume?: number;
    expanded?: boolean;
    mode?: PlayMode;
    recent?: string[];
    favorites?: string[];
  };

  const player = document.querySelector<HTMLElement>('[data-music-player]');
  const audio = player?.querySelector<HTMLAudioElement>('[data-music-audio]');
  const tracks = JSON.parse(player?.dataset.tracks || '[]') as Track[];

  if (player && audio) {
    const title = player.querySelector<HTMLElement>('[data-music-title]');
    const artist = player.querySelector<HTMLElement>('[data-music-artist]');
    const cover = player.querySelector<HTMLImageElement>('[data-music-cover]');
    const playButton = player.querySelector<HTMLButtonElement>('[data-music-play]');
    const playIcon = player.querySelector<HTMLElement>('[data-play-icon]');
    const previousButton = player.querySelector<HTMLButtonElement>('[data-music-prev]');
    const nextButton = player.querySelector<HTMLButtonElement>('[data-music-next]');
    const progress = player.querySelector<HTMLInputElement>('[data-music-progress]');
    const currentTime = player.querySelector<HTMLElement>('[data-music-current]');
    const duration = player.querySelector<HTMLElement>('[data-music-duration]');
    const volume = player.querySelector<HTMLInputElement>('[data-music-volume]');
    const muteButton = player.querySelector<HTMLButtonElement>('[data-music-mute]');
    const listToggle = player.querySelector<HTMLButtonElement>('[data-music-list-toggle]');
    const playlist = player.querySelector<HTMLElement>('[data-music-playlist]');
    const searchInput = player.querySelector<HTMLInputElement>('[data-music-search]');
    const list = player.querySelector<HTMLOListElement>('[data-music-list]');
    const empty = player.querySelector<HTMLElement>('[data-music-empty]');
    const resultCount = player.querySelector<HTMLElement>('[data-music-result-count]');
    const modeButton = player.querySelector<HTMLButtonElement>('[data-music-mode]');
    const surpriseButton = player.querySelector<HTMLButtonElement>('[data-music-surprise]');
    const qqLink = player.querySelector<HTMLAnchorElement>('[data-music-qq]');
    const status = player.querySelector<HTMLElement>('[data-music-status]');
    const storageKey = 'hdp-music-player';
    const modes: PlayMode[] = ['list', 'single', 'shuffle', 'sequential'];
    const modeLabels: Record<PlayMode, string> = {
      list: '列表循环',
      single: '单曲循环',
      shuffle: '随机播放',
      sequential: '顺序播放',
    };

    const readState = (): SavedState => {
      try {
        return JSON.parse(localStorage.getItem(storageKey) || '{}') as SavedState;
      } catch {
        return {};
      }
    };

    const saved = readState();
    const savedIndex = saved.src ? tracks.findIndex((track) => track.src === saved.src) : -1;
    let index = savedIndex >= 0
      ? savedIndex
      : Math.min(Math.max(saved.index || 0, 0), Math.max(tracks.length - 1, 0));
    let pendingTime = Math.max(saved.progress || 0, 0);
    let lastVolume = typeof saved.volume === 'number' ? Math.min(Math.max(saved.volume, 0), 1) : 0.7;
    let playMode: PlayMode = saved.mode && modes.includes(saved.mode) ? saved.mode : 'list';
    let recent = (saved.recent || []).filter((src) => tracks.some((track) => track.src === src)).slice(0, 10);
    let favorites = new Set((saved.favorites || []).filter((src) => tracks.some((track) => track.src === src)));
    let activeTag = '';
    let scope: ListScope = 'all';
    let lastProgressSave = 0;

    const formatTime = (seconds: number) => {
      if (!Number.isFinite(seconds)) return '0:00';
      const minutes = Math.floor(seconds / 60);
      return `${minutes}:${Math.floor(seconds % 60).toString().padStart(2, '0')}`;
    };

    const normalize = (value: string) => value.trim().toLocaleLowerCase('zh-CN');

    const saveState = () => {
      const currentTrack = tracks[index];
      localStorage.setItem(storageKey, JSON.stringify({
        index,
        src: currentTrack?.src,
        progress: pendingTime > 0 ? pendingTime : (Number.isFinite(audio.currentTime) ? audio.currentTime : 0),
        volume: audio.volume,
        expanded: !playlist?.hidden,
        mode: playMode,
        recent,
        favorites: [...favorites],
      }));
    };

    const getVisibleIndices = () => {
      const query = normalize(searchInput?.value || '');
      const base = scope === 'recent'
        ? recent.map((src) => tracks.findIndex((track) => track.src === src)).filter((trackIndex) => trackIndex >= 0)
        : tracks.map((_, trackIndex) => trackIndex);

      return base.filter((trackIndex) => {
        const track = tracks[trackIndex];
        const matchesScope = scope !== 'favorites' || favorites.has(track.src);
        const matchesTag = !activeTag || track.tags.includes(activeTag);
        const matchesSearch = !query || normalize(`${track.title} ${track.artist}`).includes(query);
        return matchesScope && matchesTag && matchesSearch;
      });
    };

    const updateModeButton = () => {
      if (!modeButton) return;
      const label = modeLabels[playMode];
      modeButton.textContent = `模式：${label}`;
      modeButton.setAttribute('aria-label', `当前播放模式：${label}，点击切换`);
    };

    const renderFilters = () => {
      player.querySelectorAll<HTMLButtonElement>('[data-music-scope]').forEach((button) => {
        const active = button.dataset.musicScope === scope;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });
      player.querySelectorAll<HTMLButtonElement>('[data-music-tag]').forEach((button) => {
        const active = (button.dataset.musicTag || '') === activeTag;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });
    };

    const renderList = () => {
      if (!list) return;
      const visible = getVisibleIndices();
      list.replaceChildren();
      visible.forEach((trackIndex) => {
        const track = tracks[trackIndex];
        const item = document.createElement('li');
        item.classList.toggle('is-active', trackIndex === index);

        const select = document.createElement('button');
        select.type = 'button';
        select.className = 'music-track-button';
        select.dataset.trackIndex = String(trackIndex);
        select.setAttribute('aria-label', `播放《${track.title}》—${track.artist}`);
        if (trackIndex === index) select.setAttribute('aria-current', 'true');

        const text = document.createElement('span');
        const name = document.createElement('strong');
        const byline = document.createElement('small');
        name.textContent = track.title;
        byline.textContent = track.artist;
        text.append(name, byline);

        const tags = document.createElement('small');
        tags.className = 'music-track-tags';
        tags.textContent = track.tags.slice(0, 2).join(' · ');
        select.append(text, tags);

        const favorite = document.createElement('button');
        favorite.type = 'button';
        favorite.className = 'music-favorite-button';
        favorite.dataset.favoriteIndex = String(trackIndex);
        const isFavorite = favorites.has(track.src);
        favorite.textContent = isFavorite ? '♥' : '♡';
        favorite.classList.toggle('is-active', isFavorite);
        favorite.setAttribute('aria-pressed', String(isFavorite));
        favorite.setAttribute('aria-label', `${isFavorite ? '取消收藏' : '收藏'}《${track.title}》`);

        item.append(select, favorite);
        list.append(item);
      });
      if (empty) empty.hidden = visible.length > 0 || tracks.length === 0;
      if (resultCount) resultCount.textContent = `${visible.length} 首`;
      renderFilters();
    };

    const updatePlayState = () => {
      const playing = !audio.paused;
      if (playIcon) playIcon.textContent = playing ? '❚❚' : '▶';
      playButton?.setAttribute('aria-label', playing ? '暂停' : '播放');
      player.classList.toggle('is-playing', playing);
    };

    const updateTrack = (nextIndex: number, keepSavedTime = false) => {
      if (!tracks[nextIndex]) return;
      index = nextIndex;
      const track = tracks[index];
      audio.src = track.src;
      audio.load();
      if (title) title.textContent = track.title;
      if (artist) artist.textContent = track.artist;
      if (cover) {
        cover.src = track.cover;
        cover.alt = `${track.title}封面`;
      }
      if (qqLink) {
        qqLink.hidden = !track.qqMusicUrl;
        qqLink.href = track.qqMusicUrl || '#';
      }
      if (!keepSavedTime) pendingTime = 0;
      if (status) status.textContent = `已选择《${track.title}》，点击播放后才会发出声音。`;
      renderList();
      saveState();
    };

    const playAudio = async () => {
      if (tracks.length === 0) return;
      try {
        await audio.play();
        if (status) status.textContent = `正在播放《${tracks[index].title}》`;
      } catch {
        if (status) status.textContent = '暂时无法播放，请检查本地音频文件是否存在。';
      }
      updatePlayState();
    };

    const switchTrack = async (nextIndex: number, autoplay = true) => {
      updateTrack(nextIndex);
      if (autoplay) await playAudio();
    };

    const randomIndex = (pool: number[]) => {
      const alternatives = pool.filter((trackIndex) => trackIndex !== index);
      const candidates = alternatives.length > 0 ? alternatives : pool;
      return candidates[Math.floor(Math.random() * candidates.length)];
    };

    const advance = async (fromEnded: boolean) => {
      const pool = getVisibleIndices();
      if (pool.length === 0) {
        audio.pause();
        if (status) status.textContent = '当前筛选里没有可以继续播放的歌曲。';
        return;
      }

      if (fromEnded && playMode === 'single') {
        audio.currentTime = 0;
        await playAudio();
        return;
      }
      if (playMode === 'shuffle') {
        await switchTrack(randomIndex(pool));
        return;
      }

      const position = pool.indexOf(index);
      const nextPosition = position < 0 ? 0 : position + 1;
      const shouldLoop = playMode === 'list' || (!fromEnded && playMode === 'single');
      if (nextPosition < pool.length) {
        await switchTrack(pool[nextPosition]);
      } else if (shouldLoop) {
        await switchTrack(pool[0]);
      } else {
        audio.pause();
        audio.currentTime = audio.duration || 0;
        if (status) status.textContent = '播放列表已经听完了。';
      }
    };

    const previous = async () => {
      const pool = getVisibleIndices();
      if (pool.length === 0) return;
      if (playMode === 'shuffle') {
        await switchTrack(randomIndex(pool));
        return;
      }
      const position = pool.indexOf(index);
      const previousPosition = position > 0 ? position - 1 : pool.length - 1;
      await switchTrack(pool[previousPosition]);
    };

    const recordRecent = () => {
      const src = tracks[index]?.src;
      if (!src) return;
      recent = [src, ...recent.filter((item) => item !== src)].slice(0, 10);
      if (scope === 'recent') renderList();
      saveState();
    };

    const setExpanded = (expanded: boolean) => {
      if (!playlist || !listToggle) return;
      playlist.hidden = !expanded;
      player.classList.toggle('is-expanded', expanded);
      listToggle.setAttribute('aria-expanded', String(expanded));
      listToggle.setAttribute('aria-label', expanded ? '收起播放列表' : '展开播放列表');
      listToggle.textContent = expanded ? '收起' : '展开';
      saveState();
    };

    audio.volume = lastVolume;
    if (volume) volume.value = String(lastVolume);
    updateModeButton();
    renderList();

    if (tracks.length > 0) {
      updateTrack(index, true);
      setExpanded(Boolean(saved.expanded));
    } else {
      setExpanded(false);
    }

    playButton?.addEventListener('click', async () => {
      if (audio.paused) await playAudio();
      else {
        audio.pause();
        if (status) status.textContent = '已暂停，进度会保存在这台设备上。';
      }
      updatePlayState();
    });
    previousButton?.addEventListener('click', previous);
    nextButton?.addEventListener('click', () => advance(false));
    audio.addEventListener('ended', () => advance(true));
    audio.addEventListener('play', () => {
      recordRecent();
      updatePlayState();
    });
    audio.addEventListener('pause', updatePlayState);

    audio.addEventListener('loadedmetadata', () => {
      if (pendingTime > 0 && pendingTime < audio.duration) {
        audio.currentTime = pendingTime;
        pendingTime = 0;
      }
      if (duration) duration.textContent = formatTime(audio.duration);
      if (progress) progress.max = String(audio.duration || 100);
    });
    audio.addEventListener('timeupdate', () => {
      if (currentTime) currentTime.textContent = formatTime(audio.currentTime);
      if (progress && document.activeElement !== progress) progress.value = String(audio.currentTime);
      if (Date.now() - lastProgressSave > 2000) {
        saveState();
        lastProgressSave = Date.now();
      }
    });

    progress?.addEventListener('input', () => {
      audio.currentTime = Number(progress.value);
      if (currentTime) currentTime.textContent = formatTime(audio.currentTime);
    });
    progress?.addEventListener('change', saveState);

    volume?.addEventListener('input', () => {
      audio.volume = Number(volume.value);
      audio.muted = false;
      if (audio.volume > 0) lastVolume = audio.volume;
      if (muteButton) muteButton.textContent = audio.volume === 0 ? '静' : '音';
      saveState();
    });
    muteButton?.addEventListener('click', () => {
      if (audio.muted || audio.volume === 0) {
        audio.muted = false;
        audio.volume = lastVolume || 0.7;
      } else {
        lastVolume = audio.volume;
        audio.muted = true;
      }
      if (volume) volume.value = String(audio.muted ? 0 : audio.volume);
      muteButton.textContent = audio.muted ? '静' : '音';
      muteButton.setAttribute('aria-label', audio.muted ? '取消静音' : '静音');
      saveState();
    });

    listToggle?.addEventListener('click', () => setExpanded(Boolean(playlist?.hidden)));
    searchInput?.addEventListener('input', renderList);
    player.querySelectorAll<HTMLButtonElement>('[data-music-tag]').forEach((button) => {
      button.addEventListener('click', () => {
        activeTag = button.dataset.musicTag || '';
        renderList();
      });
    });
    player.querySelectorAll<HTMLButtonElement>('[data-music-scope]').forEach((button) => {
      button.addEventListener('click', () => {
        scope = (button.dataset.musicScope || 'all') as ListScope;
        renderList();
      });
    });
    modeButton?.addEventListener('click', () => {
      playMode = modes[(modes.indexOf(playMode) + 1) % modes.length];
      updateModeButton();
      saveState();
      if (status) status.textContent = `已切换为${modeLabels[playMode]}。`;
    });
    surpriseButton?.addEventListener('click', async () => {
      const pool = getVisibleIndices();
      if (pool.length === 0) {
        if (status) status.textContent = '当前筛选里没有可以播放的歌曲。';
        return;
      }
      await switchTrack(randomIndex(pool));
    });
    list?.addEventListener('click', async (event) => {
      const target = event.target as HTMLElement;
      const favoriteButton = target.closest<HTMLButtonElement>('[data-favorite-index]');
      if (favoriteButton) {
        const trackIndex = Number(favoriteButton.dataset.favoriteIndex);
        const track = tracks[trackIndex];
        if (favorites.has(track.src)) favorites.delete(track.src);
        else favorites.add(track.src);
        saveState();
        renderList();
        return;
      }
      const trackButton = target.closest<HTMLButtonElement>('[data-track-index]');
      if (trackButton) await switchTrack(Number(trackButton.dataset.trackIndex));
    });

    addEventListener('pagehide', saveState);
    updatePlayState();
  }
</script>
