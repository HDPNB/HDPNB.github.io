---
const enabled =
  import.meta.env.PUBLIC_CLOUDBASE_ENABLED === 'true' &&
  Boolean((import.meta.env.PUBLIC_CLOUDBASE_ENV_ID || '').trim());
---

<section
  class="guestbook-encounter reveal"
  data-guestbook-encounter
  data-enabled={String(enabled)}
  aria-labelledby="guestbook-encounter-title"
>
  <div class="guestbook-encounter__intro">
    <span class="eyebrow">A SMALL ENCOUNTER</span>
    <h2 id="guestbook-encounter-title">随机遇见</h2>
    <p>在你来之前，也有人曾在这里停留片刻。</p>
  </div>
  <article class="guestbook-encounter__message" data-encounter-card hidden>
    <p data-encounter-content></p>
    <footer>
      <strong data-encounter-nickname></strong>
      <time data-encounter-time></time>
    </footer>
  </article>
  <p class="guestbook-encounter__status" data-encounter-status aria-live="polite">
    点一下按钮，和一条公开留言偶然见面。
  </p>
  <button class="button button--soft" type="button" data-encounter-button>
    遇见一条留言
  </button>
</section>

<script>
  import { loadApprovedGuestbookEncounters } from '@/lib/guestbook';
  import { entryRandom } from '@/lib/random';
  import type { GuestbookEncounterMessage } from '@/types/guestbook';

  const setupGuestbookEncounter = () => {
  const root = document.querySelector<HTMLElement>('[data-guestbook-encounter]');
  if (!root || root.dataset.encounterReady === 'true') return;
  root.dataset.encounterReady = 'true';
  const button = root?.querySelector<HTMLButtonElement>('[data-encounter-button]');
  const card = root?.querySelector<HTMLElement>('[data-encounter-card]');
  const content = root?.querySelector<HTMLElement>('[data-encounter-content]');
  const nickname = root?.querySelector<HTMLElement>('[data-encounter-nickname]');
  const time = root?.querySelector<HTMLTimeElement>('[data-encounter-time]');
  const status = root?.querySelector<HTMLElement>('[data-encounter-status]');
  let messages: GuestbookEncounterMessage[] | null = null;
  let lastIndex = -1;
  let busy = false;
  const random = entryRandom('guestbook-encounter');

  const formatDate = (date: Date) =>
    new Intl.DateTimeFormat('zh-CN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(date);

  const chooseIndex = (length: number) => {
    if (length <= 1) return 0;
    let next = Math.floor(random() * length);
    if (next === lastIndex) next = (next + 1) % length;
    return next;
  };

  const showMessage = (message: GuestbookEncounterMessage) => {
    if (!card || !content || !nickname || !time || !status || !button) return;
    card.classList.remove('is-visible');
    window.requestAnimationFrame(() => {
      content.textContent = message.content;
      nickname.textContent = message.nickname;
      time.dateTime = message.createdAt.toISOString();
      time.textContent = formatDate(message.createdAt);
      card.hidden = false;
      window.requestAnimationFrame(() => card.classList.add('is-visible'));
    });
    status.textContent = '这一刻，你们在这里轻轻碰了个面。';
    button.textContent = '再遇见一条';
  };

  button?.addEventListener('click', async () => {
    if (busy || !root) return;
    if (root.dataset.enabled !== 'true') {
      if (status) status.textContent = '留言暂时还没有连接上，晚一点再来看看吧。';
      return;
    }
    busy = true;
    button.disabled = true;
    if (status) status.textContent = '正在翻一翻公开留言…';
    try {
      if (!messages) {
        const result = await loadApprovedGuestbookEncounters();
        if (!result.ok) {
          if (status) status.textContent = result.message;
          return;
        }
        messages = result.data;
      }
      if (messages.length === 0) {
        if (status) status.textContent = '这里还没有可以遇见的留言，或许你会留下第一句。';
        return;
      }
      lastIndex = chooseIndex(messages.length);
      showMessage(messages[lastIndex]);
    } finally {
      busy = false;
      button.disabled = false;
    }
  });
  };

  document.addEventListener('astro:page-load', setupGuestbookEncounter);
</script>
