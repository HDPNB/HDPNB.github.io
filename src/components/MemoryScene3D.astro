---
import {
  memoryCardMessages,
} from '@/data/interactions';
import { memoryObjectCopies } from '@/data/copywriting';
---

<div
  class="memory-scene"
  data-memory-scene
  data-state="fallback"
  data-object-quotes={JSON.stringify(memoryObjectCopies)}
  data-cards={JSON.stringify(memoryCardMessages)}
  aria-label="漂浮的记忆胶囊互动场景"
>
  <canvas class="memory-scene__canvas" data-memory-canvas aria-hidden="true"></canvas>
  <span class="memory-scene__pulse" data-memory-pulse aria-hidden="true"></span>

  <div class="memory-scene__fallback" aria-hidden="false">
    <span class="memory-scene__halo" aria-hidden="true"></span>
    <button
      class="memory-scene__capsule"
      type="button"
      data-memory-trigger="0"
      aria-label="点亮主要记忆胶囊"
      title="点亮主要记忆胶囊"
    ></button>
    <button
      class="memory-scene__orb memory-scene__orb--one"
      type="button"
      data-memory-trigger="1"
      aria-label="点亮漂浮的小球"
      title="点亮漂浮的小球"
    ></button>
    <span class="memory-scene__orb memory-scene__orb--two" aria-hidden="true"></span>
    <button
      class="memory-scene__card memory-scene__card--one"
      type="button"
      data-memory-trigger="2"
      aria-label="点亮漂浮的日记卡片"
      title="点亮漂浮的日记卡片"
    ></button>
    <span class="memory-scene__card memory-scene__card--two" aria-hidden="true"></span>
  </div>

  <div class="memory-scene__lights" aria-label="点亮三段今日记忆">
    <span>点亮记忆</span>
    <div role="group" aria-label="三个记忆对象">
      {[0, 1, 2].map((index) => (
        <button
          type="button"
          data-memory-trigger={String(index)}
          data-memory-light={String(index)}
          aria-label={`点亮第 ${index + 1} 个记忆对象`}
          aria-pressed="false"
          title={`点亮第 ${index + 1} 个记忆对象`}
        ></button>
      ))}
    </div>
    <button
      class="memory-scene__card-open"
      type="button"
      data-memory-card-open
      hidden
    >
      今日记忆卡
    </button>
  </div>

  <div
    class="memory-scene__message"
    data-memory-message
    role="status"
    aria-live="polite"
    hidden
  >
    <button type="button" data-memory-message-close aria-label="关闭记忆短句">×</button>
    <p data-memory-message-text></p>
  </div>

  <div
    class="memory-scene__complete"
    data-memory-complete
    role="status"
    aria-live="polite"
    hidden
  >
    <span data-memory-complete-meta>今日记忆卡</span>
    <p data-memory-complete-text></p>
    <button type="button" data-memory-complete-close>收好这张卡</button>
  </div>

  <span class="sr-only" data-memory-status aria-live="polite">
    正在准备轻量三维场景
  </span>
</div>

<script>
  import type {
    BufferGeometry,
    Group,
    Material,
    Mesh,
    MeshStandardMaterial,
    PerspectiveCamera,
    Points,
    Raycaster,
    Scene,
    Vector2,
    WebGLRenderer,
  } from 'three';
  import {
    entryRandom,
    pickRandom,
  } from '@/lib/random';
  import {
    drawDailyMemoryCard,
    getDailyMemoryState,
  } from '@/lib/site-interactions';
  import type { DailyDrawState } from '@/types/site-interactions';

  interface MemoryState {
    lit: number[];
  }

  interface MemoryCardCopy {
    text: string;
    subtitle: string;
    mood: string;
  }

  const setupMemoryScene = () => {
  const rootCheck = document.querySelector<HTMLElement>('[data-memory-scene]');
  if (!rootCheck || rootCheck.dataset.memorySceneReady === 'true') return;
  rootCheck.dataset.memorySceneReady = 'true';

  const idleApi = window as unknown as {
    requestIdleCallback?: (
      callback: IdleRequestCallback,
      options?: IdleRequestOptions,
    ) => number;
    cancelIdleCallback?: (handle: number) => void;
  };
  const root = document.querySelector<HTMLElement>('[data-memory-scene]');
  const canvas = root?.querySelector<HTMLCanvasElement>('[data-memory-canvas]');
  const status = root?.querySelector<HTMLElement>('[data-memory-status]');
  const message = root?.querySelector<HTMLElement>('[data-memory-message]');
  const messageText = root?.querySelector<HTMLElement>('[data-memory-message-text]');
  const completeCard = root?.querySelector<HTMLElement>('[data-memory-complete]');
  const completeText = root?.querySelector<HTMLElement>('[data-memory-complete-text]');
  const completeMeta = root?.querySelector<HTMLElement>('[data-memory-complete-meta]');
  const cardOpenButton = root?.querySelector<HTMLButtonElement>('[data-memory-card-open]');
  const objectQuotes = JSON.parse(root?.dataset.objectQuotes || '{}') as {
    capsule?: string[];
    orb?: string[];
    paper?: string[];
  };
  const cardMessages = JSON.parse(root?.dataset.cards || '[]') as MemoryCardCopy[];
  const pulse = root?.querySelector<HTMLElement>('[data-memory-pulse]');
  const sceneRandom = entryRandom('memory-scene');
  const quoteRandom = entryRandom('memory-quotes');
  const lastQuoteIndices = [-1, -1, -1];
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const mobile = window.matchMedia('(max-width: 720px)');
  const device = navigator as Navigator & { deviceMemory?: number };
  const lowPower =
    (navigator.hardwareConcurrency && navigator.hardwareConcurrency <= 4) ||
    (device.deviceMemory && device.deviceMemory <= 4);
  const MOTION_STORAGE_KEY = 'hdp-motion-effects';
  const MEMORY_STORAGE_PREFIX = 'hdp-memory-lights';

  let scene: Scene | undefined;
  let camera: PerspectiveCamera | undefined;
  let renderer: WebGLRenderer | undefined;
  let backgroundGroup: Group | undefined;
  let middleGroup: Group | undefined;
  let foregroundGroup: Group | undefined;
  let raycaster: Raycaster | undefined;
  let rayPointer: Vector2 | undefined;
  let animationFrame = 0;
  let idleHandle = 0;
  let messageTimer = 0;
  let completeTimer = 0;
  let initialized = false;
  let initializing = false;
  let intersecting = false;
  let destroyed = false;
  let pointerX = 0;
  let pointerY = 0;
  let dragYaw = 0;
  let dragPitch = 0;
  let dragging = false;
  let activePointerId = -1;
  let pointerStartX = 0;
  let pointerStartY = 0;
  let previousPointerX = 0;
  let previousPointerY = 0;
  let dragDistance = 0;
  let hoverIndex = -1;
  let lastFrame = 0;
  let lastMessageAt = 0;
  let observer: IntersectionObserver | undefined;
  let resizeObserver: ResizeObserver | undefined;
  const geometries: BufferGeometry[] = [];
  const materials: Material[] = [];
  const interactiveObjects: Mesh[] = [];

  const localDateKey = () => {
    const now = new Date();
    return [
      now.getFullYear(),
      String(now.getMonth() + 1).padStart(2, '0'),
      String(now.getDate()).padStart(2, '0'),
    ].join('-');
  };
  const memoryStorageKey = `${MEMORY_STORAGE_PREFIX}:${localDateKey()}`;

  const readMemoryState = (): MemoryState => {
    try {
      const value = JSON.parse(localStorage.getItem(memoryStorageKey) || '{}') as Partial<MemoryState>;
      const lit = Array.isArray(value.lit)
        ? [...new Set(value.lit.filter((item) => Number.isInteger(item) && item >= 0 && item < 3))]
        : [];
      return {
        lit,
      };
    } catch {
      return { lit: [] };
    }
  };
  let memoryState = readMemoryState();
  let dailyCardState: DailyDrawState | null = null;
  let cardBusy = false;

  const saveMemoryState = () => {
    try {
      localStorage.setItem(memoryStorageKey, JSON.stringify(memoryState));
    } catch {
      // This interaction is optional and device-local.
    }
  };

  const effectsEnabled = () => {
    try {
      return localStorage.getItem(MOTION_STORAGE_KEY) !== 'off';
    } catch {
      return true;
    }
  };

  const canAnimate = () =>
    initialized &&
    intersecting &&
    !document.hidden &&
    !reducedMotion.matches &&
    effectsEnabled();

  const supportsWebGL = () => {
    try {
      const testCanvas = document.createElement('canvas');
      return Boolean(
        window.WebGLRenderingContext &&
          (testCanvas.getContext('webgl2') || testCanvas.getContext('webgl')),
      );
    } catch {
      return false;
    }
  };

  const setFallback = (text: string) => {
    if (root) root.dataset.state = 'fallback';
    if (status) status.textContent = text;
  };

  const renderLights = () => {
    root?.querySelectorAll<HTMLButtonElement>('[data-memory-light]').forEach((button) => {
      const index = Number(button.dataset.memoryLight);
      const active = memoryState.lit.includes(index);
      button.classList.toggle('is-lit', active);
      button.setAttribute('aria-pressed', String(active));
    });
    if (cardOpenButton) {
      cardOpenButton.hidden = memoryState.lit.length < 3;
      cardOpenButton.disabled = cardBusy || dailyCardState?.reachedLimit === true;
      cardOpenButton.textContent = dailyCardState?.reachedLimit
        ? '今天的三段记忆已经收好'
        : dailyCardState
          ? `今日记忆卡 · 还剩 ${dailyCardState.remaining} 次`
          : '今日记忆卡';
    }
  };

  const hideMessage = () => {
    clearTimeout(messageTimer);
    message?.classList.remove('is-visible');
    window.setTimeout(() => {
      if (message) message.hidden = true;
    }, 260);
  };

  const showMessage = (text: string) => {
    if (!message || !messageText || !text) return;
    clearTimeout(messageTimer);
    messageText.textContent = text;
    message.hidden = false;
    requestAnimationFrame(() => message.classList.add('is-visible'));
    messageTimer = window.setTimeout(hideMessage, 6500);
  };

  const showCompleteCard = (copy: MemoryCardCopy, state: DailyDrawState) => {
    if (!completeCard || !completeText || cardMessages.length === 0) return;
    hideMessage();
    completeText.textContent = copy.text;
    if (completeMeta) {
      completeMeta.textContent = `${copy.subtitle} · ${copy.mood} · ${state.used}/${state.limit}`;
    }
    completeCard.hidden = false;
    requestAnimationFrame(() => completeCard.classList.add('is-visible'));
  };

  const revealCompleteCard = async () => {
    if (cardBusy || memoryState.lit.length < 3 || cardMessages.length === 0) return;
    cardBusy = true;
    renderLights();
    const result = await drawDailyMemoryCard();
    cardBusy = false;
    if (result.ok) {
      dailyCardState = result.data;
      renderLights();
      if (result.data.card) {
        const copy = cardMessages[result.data.card.index % cardMessages.length];
        if (copy) showCompleteCard(copy, result.data);
      }
      return;
    }
    if (result.data) {
      dailyCardState = result.data;
      renderLights();
      const latest = result.data.cards[result.data.cards.length - 1];
      if (latest) {
        const copy = cardMessages[latest.index % cardMessages.length];
        if (copy) showCompleteCard(copy, result.data);
      }
    }
    showMessage(result.message);
  };

  const syncDailyCardState = async () => {
    const result = await getDailyMemoryState();
    if (result.ok) dailyCardState = result.data;
    renderLights();
  };

  const hideCompleteCard = () => {
    clearTimeout(completeTimer);
    completeCard?.classList.remove('is-visible');
    window.setTimeout(() => {
      if (completeCard) completeCard.hidden = true;
    }, 260);
  };

  const pulsePositions = [
    { x: 50, y: 50 },
    { x: 24, y: 28 },
    { x: 76, y: 28 },
  ];

  const showPulse = (index: number, point?: { x: number; y: number }) => {
    if (!pulse || !root) return;
    const fallback = pulsePositions[index] || pulsePositions[0];
    const rect = root.getBoundingClientRect();
    const x = point ? ((point.x - rect.left) / rect.width) * 100 : fallback.x;
    const y = point ? ((point.y - rect.top) / rect.height) * 100 : fallback.y;
    pulse.style.left = `${Math.max(4, Math.min(96, x))}%`;
    pulse.style.top = `${Math.max(4, Math.min(96, y))}%`;
    pulse.classList.remove('is-active');
    requestAnimationFrame(() => pulse.classList.add('is-active'));
  };

  const activateMemory = (index: number, point?: { x: number; y: number }) => {
    if (!Number.isInteger(index) || index < 0 || index > 2) return;
    if (performance.now() - lastMessageAt < 550) return;
    lastMessageAt = performance.now();

    if (!memoryState.lit.includes(index)) {
      memoryState.lit.push(index);
      memoryState.lit.sort();
      saveMemoryState();
      renderLights();
    }
    const sources = [
      objectQuotes.capsule || [],
      objectQuotes.orb || [],
      objectQuotes.paper || [],
    ];
    const source = sources[index] || [];
    const picked = pickRandom(source, quoteRandom, lastQuoteIndices[index]);
    lastQuoteIndices[index] = picked.index;
    const quote = picked.value;
    showPulse(index, point);
    if (quote) showMessage(quote);

    if (memoryState.lit.length === 3) {
      clearTimeout(completeTimer);
      completeTimer = window.setTimeout(() => {
        void revealCompleteCard();
      }, 900);
    }
  };

  const resize = () => {
    if (!root || !camera || !renderer) return;
    const rect = root.getBoundingClientRect();
    if (!rect.width || !rect.height) return;
    camera.aspect = rect.width / rect.height;
    camera.updateProjectionMatrix();
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.5));
    renderer.setSize(rect.width, rect.height, false);
  };

  const updateInteractiveObjects = () => {
    interactiveObjects.forEach((object, index) => {
      const target = index === hoverIndex ? 1.09 : 1;
      object.scale.x += (target - object.scale.x) * 0.11;
      object.scale.y += (target - object.scale.y) * 0.11;
      object.scale.z += (target - object.scale.z) * 0.11;
      const material = object.material as MeshStandardMaterial;
      if ('emissiveIntensity' in material) {
        const intensity = index === hoverIndex ? 0.22 : 0.045;
        material.emissiveIntensity +=
          (intensity - material.emissiveIntensity) * 0.1;
      }
    });
  };

  const renderFrame = (time = performance.now()) => {
    if (
      !renderer ||
      !scene ||
      !camera ||
      !backgroundGroup ||
      !middleGroup ||
      !foregroundGroup ||
      destroyed
    ) {
      return;
    }
    if (!canAnimate()) {
      animationFrame = 0;
      return;
    }

    const targetFps = lowPower ? 30 : 40;
    if (time - lastFrame < 1000 / targetFps) {
      animationFrame = requestAnimationFrame(renderFrame);
      return;
    }
    lastFrame = time;
    const elapsed = time * 0.001;

    if (!dragging) {
      dragYaw *= 0.982;
      dragPitch *= 0.982;
    }
    middleGroup.rotation.y +=
      (pointerX * 0.26 + dragYaw - middleGroup.rotation.y) * 0.045;
    middleGroup.rotation.x +=
      (pointerY * 0.15 + dragPitch - middleGroup.rotation.x) * 0.045;
    foregroundGroup.rotation.y +=
      (pointerX * 0.38 + dragYaw * 1.2 - foregroundGroup.rotation.y) * 0.05;
    foregroundGroup.rotation.x +=
      (pointerY * 0.21 + dragPitch * 1.2 - foregroundGroup.rotation.x) * 0.05;
    backgroundGroup.rotation.y +=
      (-pointerX * 0.08 - backgroundGroup.rotation.y) * 0.025;
    backgroundGroup.rotation.x +=
      (-pointerY * 0.04 - backgroundGroup.rotation.x) * 0.025;
    middleGroup.position.y = Math.sin(elapsed * 0.48) * 0.13;
    foregroundGroup.position.y = Math.sin(elapsed * 0.62 + 0.7) * 0.17;
    backgroundGroup.position.y = Math.sin(elapsed * 0.24) * 0.08;

    [...middleGroup.children, ...foregroundGroup.children].forEach((child, index) => {
      const baseY =
        typeof child.userData.baseY === 'number'
          ? child.userData.baseY
          : child.position.y;
      child.position.y =
        baseY +
        Math.sin(
          elapsed * (0.42 + (index % 4) * 0.095) +
            (typeof child.userData.floatPhase === 'number'
              ? child.userData.floatPhase
              : index),
        ) *
          (0.025 + (index % 3) * 0.012);
      child.rotation.z += index % 2 === 0 ? 0.00055 : -0.00042;
    });
    updateInteractiveObjects();
    renderer.render(scene, camera);
    animationFrame = requestAnimationFrame(renderFrame);
  };

  const start = () => {
    if (animationFrame || !canAnimate()) return;
    animationFrame = requestAnimationFrame(renderFrame);
  };

  const stop = () => {
    if (animationFrame) cancelAnimationFrame(animationFrame);
    animationFrame = 0;
  };

  const initialize = async () => {
    if (!root || !canvas || initialized || initializing || destroyed) return;
    if (mobile.matches) {
      setFallback('手机端使用可交互的静态记忆胶囊，以减少性能消耗');
      return;
    }
    if (lowPower) {
      setFallback('当前设备使用可交互的静态记忆胶囊');
      return;
    }
    if (reducedMotion.matches) {
      setFallback('已根据系统设置使用静态记忆胶囊');
      return;
    }
    if (!effectsEnabled()) {
      setFallback('动态效果已关闭，当前显示静态记忆胶囊');
      return;
    }
    if (!supportsWebGL()) {
      setFallback('浏览器不支持 WebGL，已显示静态记忆胶囊');
      return;
    }

    initializing = true;
    if (status) status.textContent = '正在轻轻展开三维记忆胶囊';

    try {
      const THREE = await import('three');
      if (destroyed) return;

      scene = new THREE.Scene();
      camera = new THREE.PerspectiveCamera(37, 1, 0.1, 100);
      camera.position.set(0, 0.12, 9.8);

      renderer = new THREE.WebGLRenderer({
        canvas,
        alpha: true,
        antialias: true,
        powerPreference: 'default',
      });
      renderer.setClearColor(0x000000, 0);
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 0.93;
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFShadowMap;
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.5));

      backgroundGroup = new THREE.Group();
      middleGroup = new THREE.Group();
      foregroundGroup = new THREE.Group();
      scene.add(backgroundGroup, middleGroup, foregroundGroup);

      const addMesh = (
        group: Group,
        geometry: BufferGeometry,
        material: Material,
        position: [number, number, number],
        rotation: [number, number, number] = [0, 0, 0],
        memoryIndex?: number,
      ) => {
        const object = new THREE.Mesh(geometry, material) as Mesh;
        object.position.set(...position);
        object.rotation.set(
          rotation[0] + (sceneRandom() - 0.5) * 0.045,
          rotation[1] + (sceneRandom() - 0.5) * 0.085,
          rotation[2] + (sceneRandom() - 0.5) * 0.065,
        );
        object.userData.baseY = position[1];
        object.userData.floatPhase = sceneRandom() * Math.PI * 2;
        object.castShadow = true;
        object.receiveShadow = true;
        if (memoryIndex !== undefined) {
          object.userData.memoryIndex = memoryIndex;
          interactiveObjects.push(object);
        }
        group.add(object);
        geometries.push(geometry);
        materials.push(material);
        return object;
      };

      const capsuleMaterial = new THREE.MeshPhysicalMaterial({
        color: 0x93a99a,
        emissive: 0x5f766a,
        emissiveIntensity: 0.045,
        roughness: 0.18,
        metalness: 0.02,
        transparent: true,
        opacity: 0.68,
        transmission: 0.34,
        thickness: 0.9,
        clearcoat: 0.68,
        clearcoatRoughness: 0.24,
      });
      const blueOrbMaterial = new THREE.MeshPhysicalMaterial({
        color: 0x93aeb8,
        emissive: 0x607b84,
        emissiveIntensity: 0.045,
        roughness: 0.22,
        transparent: true,
        opacity: 0.82,
        transmission: 0.16,
        clearcoat: 0.55,
      });
      const paperMaterial = new THREE.MeshStandardMaterial({
        color: 0xe8dfce,
        emissive: 0x8c806d,
        emissiveIntensity: 0.045,
        roughness: 0.66,
      });
      const mistMaterial = new THREE.MeshPhysicalMaterial({
        color: 0xa4b5b8,
        roughness: 0.38,
        transparent: true,
        opacity: 0.48,
        transmission: 0.22,
        side: THREE.DoubleSide,
      });
      const warmMaterial = new THREE.MeshStandardMaterial({
        color: 0xb29a7e,
        roughness: 0.58,
        transparent: true,
        opacity: 0.72,
      });
      const greenMaterial = new THREE.MeshStandardMaterial({
        color: 0x82998a,
        roughness: 0.48,
        transparent: true,
        opacity: 0.7,
      });

      addMesh(
        middleGroup,
        new THREE.BoxGeometry(2.55, 3.05, 1.62, 3, 3, 3),
        capsuleMaterial,
        [0, 0, 0],
        [0.12, -0.3, 0.08],
        0,
      );
      addMesh(
        foregroundGroup,
        new THREE.SphereGeometry(0.82, 32, 24),
        blueOrbMaterial,
        [-1.72, 1.3, 0.9],
        [0, 0, 0],
        1,
      );
      addMesh(
        foregroundGroup,
        new THREE.BoxGeometry(1.32, 1.72, 0.09),
        paperMaterial,
        [1.62, 1.12, 1.02],
        [0.08, -0.38, 0.13],
        2,
      );

      addMesh(
        middleGroup,
        new THREE.SphereGeometry(0.4, 24, 18),
        warmMaterial,
        [1.74, -1.45, 0.32],
      );
      addMesh(
        middleGroup,
        new THREE.TorusGeometry(1.83, 0.062, 14, 88),
        warmMaterial.clone(),
        [0.08, -0.12, -0.78],
        [1.12, 0.18, -0.3],
      );

      addMesh(
        foregroundGroup,
        new THREE.BoxGeometry(1.08, 1.38, 0.07),
        greenMaterial,
        [-1.58, -1.08, 0.62],
        [-0.12, 0.34, -0.16],
      );
      addMesh(
        middleGroup,
        new THREE.PlaneGeometry(1.45, 2.15),
        mistMaterial,
        [2.05, -0.45, -0.9],
        [0.08, -0.56, 0.12],
      );
      addMesh(
        backgroundGroup,
        new THREE.TorusGeometry(2.65, 0.034, 10, 96),
        greenMaterial.clone(),
        [-0.15, 0.05, -2.1],
        [1.35, -0.12, 0.45],
      );

      for (let index = 0; index < 5; index += 1) {
        addMesh(
          backgroundGroup,
          new THREE.PlaneGeometry(0.58 + index * 0.06, 0.78 + index * 0.05),
          index % 2 === 0 ? mistMaterial.clone() : paperMaterial.clone(),
          [
            -2.7 + index * 1.33,
            -1.85 + (index % 3) * 1.55,
            -2.8 - (index % 2) * 0.7,
          ],
          [0.1 * index, -0.18 + index * 0.08, -0.22 + index * 0.1],
        );
      }

      const starPositions: number[] = [];
      for (let index = 0; index < 54; index += 1) {
        starPositions.push(
          (sceneRandom() - 0.5) * 7.8,
          (sceneRandom() - 0.5) * 5.9,
          -1.8 - sceneRandom() * 3.4,
        );
      }
      const starGeometry = new THREE.BufferGeometry();
      starGeometry.setAttribute(
        'position',
        new THREE.Float32BufferAttribute(starPositions, 3),
      );
      const starMaterial = new THREE.PointsMaterial({
        color: 0xc7d0c7,
        size: 0.045,
        transparent: true,
        opacity: 0.48,
        sizeAttenuation: true,
      });
      const stars = new THREE.Points(starGeometry, starMaterial) as Points;
      backgroundGroup.add(stars);
      geometries.push(starGeometry);
      materials.push(starMaterial);

      const shadowMaterial = new THREE.ShadowMaterial({
        color: 0x435047,
        opacity: 0.14,
      });
      const shadowPlane = addMesh(
        backgroundGroup,
        new THREE.CircleGeometry(2.35, 48),
        shadowMaterial,
        [0, -2.25, -0.2],
        [-Math.PI / 2, 0, 0],
      );
      shadowPlane.castShadow = false;

      const hemisphere = new THREE.HemisphereLight(0xf5f0e5, 0x4c5e55, 2.45);
      const key = new THREE.DirectionalLight(0xe1ebe3, 4.1);
      key.position.set(4.6, 6.2, 7.4);
      key.castShadow = true;
      key.shadow.mapSize.set(512, 512);
      key.shadow.camera.near = 1;
      key.shadow.camera.far = 18;
      const fill = new THREE.PointLight(0x9ebbc5, 3.1, 13, 2);
      fill.position.set(-4.2, 1.2, 4.8);
      const warmPoint = new THREE.PointLight(0xd6b994, 2.5, 10, 2);
      warmPoint.position.set(3.1, -2.6, 3.8);
      scene.add(hemisphere, key, fill, warmPoint);

      raycaster = new THREE.Raycaster();
      rayPointer = new THREE.Vector2();
      resize();
      renderer.render(scene, camera);
      initialized = true;
      root.dataset.state = 'ready';
      if (status) status.textContent = '三维记忆胶囊已经准备好，可以拖动或点亮物体';
      start();
    } catch {
      setFallback('三维场景暂时无法加载，已显示可交互的静态记忆胶囊');
    } finally {
      initializing = false;
    }
  };

  const scheduleInitialize = () => {
    if (initialized || initializing || destroyed || !intersecting) return;
    if (idleApi.requestIdleCallback) {
      idleHandle = idleApi.requestIdleCallback(() => initialize(), {
        timeout: 1200,
      });
    } else {
      idleHandle = window.setTimeout(initialize, 260);
    }
  };

  const updateRaycast = (event: PointerEvent) => {
    if (!root || !camera || !raycaster || !rayPointer || !initialized) return -1;
    const rect = root.getBoundingClientRect();
    rayPointer.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
    rayPointer.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;
    raycaster.setFromCamera(rayPointer, camera);
    const hit = raycaster.intersectObjects(interactiveObjects, false)[0];
    return hit && typeof hit.object.userData.memoryIndex === 'number'
      ? hit.object.userData.memoryIndex
      : -1;
  };

  const handlePointerMove = (event: PointerEvent) => {
    if (!root || event.target instanceof Element && event.target.closest('button')) return;
    const rect = root.getBoundingClientRect();
    pointerX = ((event.clientX - rect.left) / rect.width - 0.5) * 2;
    pointerY = ((event.clientY - rect.top) / rect.height - 0.5) * 2;
    if (dragging && event.pointerId === activePointerId) {
      const deltaX = event.clientX - previousPointerX;
      const deltaY = event.clientY - previousPointerY;
      dragYaw = Math.max(-0.52, Math.min(0.52, dragYaw + deltaX * 0.0045));
      dragPitch = Math.max(-0.28, Math.min(0.28, dragPitch + deltaY * 0.0035));
      dragDistance += Math.abs(deltaX) + Math.abs(deltaY);
      previousPointerX = event.clientX;
      previousPointerY = event.clientY;
    } else {
      hoverIndex = updateRaycast(event);
      root.classList.toggle('is-object-hovered', hoverIndex >= 0);
    }
  };

  const handlePointerDown = (event: PointerEvent) => {
    if (!root || event.target !== canvas || !initialized) return;
    dragging = true;
    activePointerId = event.pointerId;
    pointerStartX = event.clientX;
    pointerStartY = event.clientY;
    previousPointerX = event.clientX;
    previousPointerY = event.clientY;
    dragDistance = 0;
    root.setPointerCapture?.(event.pointerId);
  };

  const handlePointerUp = (event: PointerEvent) => {
    if (!root || !dragging || event.pointerId !== activePointerId) return;
    if (
      dragDistance < 8 &&
      Math.hypot(
        event.clientX - pointerStartX,
        event.clientY - pointerStartY,
      ) < 8
    ) {
      const memoryIndex = updateRaycast(event);
      if (memoryIndex >= 0) {
        activateMemory(memoryIndex, { x: event.clientX, y: event.clientY });
      }
    }
    dragging = false;
    activePointerId = -1;
    root.releasePointerCapture?.(event.pointerId);
  };

  const handlePointerLeave = () => {
    pointerX = 0;
    pointerY = 0;
    hoverIndex = -1;
    dragging = false;
    activePointerId = -1;
    root?.classList.remove('is-object-hovered');
  };

  const handleRootClick = (event: MouseEvent) => {
    if (!(event.target instanceof Element)) return;
    if (event.target.closest('[data-memory-message-close]')) {
      hideMessage();
      return;
    }
    if (event.target.closest('[data-memory-complete-close]')) {
      hideCompleteCard();
      return;
    }
    if (event.target.closest('[data-memory-card-open]')) {
      void revealCompleteCard();
      return;
    }
    const trigger = event.target.closest<HTMLElement>('[data-memory-trigger]');
    if (trigger) {
      const rect = trigger.getBoundingClientRect();
      activateMemory(Number(trigger.dataset.memoryTrigger), {
        x: rect.left + rect.width / 2,
        y: rect.top + rect.height / 2,
      });
    }
  };

  const handleStateChange = () => {
    if (!initialized && effectsEnabled() && !reducedMotion.matches) {
      scheduleInitialize();
    }
    if (initialized && root) {
      root.dataset.state =
        effectsEnabled() && !reducedMotion.matches ? 'ready' : 'fallback';
    }
    if (canAnimate()) start();
    else stop();
  };

  const handleAuthChange = () => {
    void syncDailyCardState();
  };

  const cleanup = () => {
    if (destroyed) return;
    destroyed = true;
    stop();
    clearTimeout(messageTimer);
    clearTimeout(completeTimer);
    observer?.disconnect();
    resizeObserver?.disconnect();
    root?.removeEventListener('pointermove', handlePointerMove);
    root?.removeEventListener('pointerdown', handlePointerDown);
    root?.removeEventListener('pointerup', handlePointerUp);
    root?.removeEventListener('pointercancel', handlePointerUp);
    root?.removeEventListener('pointerleave', handlePointerLeave);
    root?.removeEventListener('click', handleRootClick);
    window.removeEventListener('hdp:motion-changed', handleStateChange);
    window.removeEventListener('hdp:auth-changed', handleAuthChange);
    document.removeEventListener('visibilitychange', handleStateChange);
    reducedMotion.removeEventListener('change', handleStateChange);
    document.removeEventListener('astro:before-swap', cleanup);
    window.removeEventListener('pagehide', cleanup);
    if (idleHandle) {
      if (idleApi.cancelIdleCallback) idleApi.cancelIdleCallback(idleHandle);
      else clearTimeout(idleHandle);
    }
    geometries.forEach((geometry) => geometry.dispose());
    materials.forEach((material) => material.dispose());
    renderer?.dispose();
    renderer?.forceContextLoss();
    scene?.clear();
    geometries.length = 0;
    materials.length = 0;
    interactiveObjects.length = 0;
  };

  if (root && canvas) {
    renderLights();
    void syncDailyCardState();

    observer = new IntersectionObserver(
      ([entry]) => {
        intersecting = Boolean(entry?.isIntersecting);
        if (intersecting) {
          scheduleInitialize();
          start();
        } else {
          stop();
        }
      },
      { rootMargin: '140px 0px', threshold: 0.08 },
    );
    observer.observe(root);
    resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(root);
    root.addEventListener('pointermove', handlePointerMove, { passive: true });
    root.addEventListener('pointerdown', handlePointerDown);
    root.addEventListener('pointerup', handlePointerUp);
    root.addEventListener('pointercancel', handlePointerUp);
    root.addEventListener('pointerleave', handlePointerLeave);
    root.addEventListener('click', handleRootClick);
    window.addEventListener('hdp:motion-changed', handleStateChange);
    window.addEventListener('hdp:auth-changed', handleAuthChange);
    document.addEventListener('visibilitychange', handleStateChange);
    reducedMotion.addEventListener('change', handleStateChange);
    document.addEventListener('astro:before-swap', cleanup, { once: true });
    window.addEventListener('pagehide', cleanup, { once: true });
  }
  };

  document.addEventListener('astro:page-load', setupMemoryScene);
</script>
